// ============================================================================
// Zewa Feeds — database schema
//
// Derived from CMS/lib/seed.js (the de-facto schema the CMS was built against)
// and the storefront's hardcoded product shapes. Section references (§) point at
// CMS/Zewa_Feeds_CMS_Specification_v2.docx.
//
// Two conventions that hold everywhere:
//   1. Money is an Int in paise. Never a float, never rupees.
//   2. Anything an order needs for an invoice is SNAPSHOT onto the order at
//      purchase time — the catalogue changes, invoices must not.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (macOS). The debian target is what Render and
  // most Linux hosts run — without it the deployed client fails at startup
  // with "Query engine binary for current platform could not be found".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/// PRODUCT TYPE — how the feed behaves, which is how the catalogue is browsed.
///
/// Deliberately NOT species. A feed suits many species (F2 covers six tetra
/// varieties) and a species eats many feeds, so species is a MANY-valued
/// attribute and lives in `ProductFamily.tags`. Forcing it into this enum would
/// have thrown that detail away.
///
/// Pack size is likewise absent: 11 of 13 products ship both a 45g and a 1kg
/// SKU, so "1kg" is a variant filter (`ProductVariant.pack`), not a category —
/// otherwise one product would need to be in two categories at once.
enum Category {
  DRIED_BSF_LARVAE
  FLOATING_PELLETS
  SLOW_SINKING_PELLETS
  BOTTOM_DWELLERS
  HATCHERY_FEEDS

  // ---- Legacy species values -------------------------------------------
  // Kept so existing rows and any stored filter/URL remain valid. Postgres
  // cannot drop an enum value that data or a default might still reference.
  // Do not assign these to new products.
  BETTA
  CICHLID
  HATCHERY
  GUPPY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  COMING_SOON
  /// Temporarily off sale but not retired — hidden from the storefront, kept in
  /// the catalogue so it can be switched back to ACTIVE without re-creating it.
  /// Distinct from DISCONTINUED, which means "gone for good".
  INACTIVE
  DISCONTINUED
}

enum Badge {
  BESTSELLER
  NEW
  PRO
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum CustomerStatus {
  ACTIVE
  BANNED
}

enum Role {
  CONTENT_EDITOR
  OPS_MANAGER
  ADMIN
}

enum CmsUserStatus {
  ACTIVE
  DEACTIVATED
  INVITED
}

enum TwofaMethod {
  TOTP
  SMS_OTP
  EMAIL_OTP
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  FLAT
  PERCENTAGE
  /// Zeroes the shipping charge. The weight/slab calculation still runs — this
  /// only waives what it produced, so CMS shipping config stays authoritative.
  FREE_SHIPPING
  /// Free or discounted units of a target product. See CouponBxgy.
  BUY_X_GET_Y
}

/// Which products a coupon applies to (§10.2 extension).
enum CouponScope {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
}

/// Whether a coupon may be combined with others.
///
/// STACKABLE      combines freely with other STACKABLE promotions.
/// NON_STACKABLE  applies alone; any other code alongside it is refused.
/// EXCLUSIVE      applies alone AND outranks everything else when the engine
///                has to choose between eligible promotions.
///
/// NON_STACKABLE is the default because it is what the system did before this
/// setting existed — one coupon per cart. Stacking is opt-in, per coupon.
enum CouponStacking {
  STACKABLE
  NON_STACKABLE
  EXCLUSIVE
}

/// Does the customer type a code, or does the engine apply it on its own?
enum CouponTrigger {
  CODE
  AUTOMATIC
}

/// Which customers a promotion is for, by order history or by name.
enum CustomerEligibility {
  ALL_CUSTOMERS
  /// No qualifying orders yet.
  FIRST_ORDER
  /// Fewer than `firstNOrders` qualifying orders.
  FIRST_N_ORDERS
  /// At least one qualifying order.
  EXISTING_CUSTOMER
  /// Only the emails listed in CouponCustomer.
  SPECIFIC_CUSTOMERS
}

/// What a targeting row means.
///
/// The distinction that stops a qualifying product being discounted by accident:
/// DISCOUNT rows say what the money comes off, QUALIFY rows say what must be in
/// the cart for the promotion to fire at all, EXCLUDE rows carve exceptions out
/// of a broader DISCOUNT selection.
enum CouponTargetRole {
  DISCOUNT
  QUALIFY
  EXCLUDE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContentVersion {
  LIVE
  DRAFT
}

enum AuditModule {
  PRODUCTS
  ORDERS
  CONTENT
  REVIEWS
  COUPONS
  CUSTOMERS
  USERS
  SETTINGS
  AUTH
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ============================================================================
// PRODUCTS (§5)
//
// Two levels: ProductFamily ("Betta Bites F3") and ProductVariant ("45 g").
// Every family has one PDP; its variants are the pack selector.
// ============================================================================

model ProductFamily {
  id       String        @id @default(uuid())
  /// Immutable after first publish (§5.2).
  slug     String        @unique
  name     String
  category Category
  status   ProductStatus @default(DRAFT)
  badge    Badge?

  /// Merchandising order across every customer-facing product listing.
  ///
  /// PRODUCT order, not variant order. `ProductVariant.position` sequences the
  /// packs INSIDE one product and is a separate concern this does not touch;
  /// likewise `ProductMedia.position` for a gallery.
  ///
  /// The storefront listed products by `[status, name]`, so the catalogue was
  /// alphabetical by accident. This makes the sequence an explicit decision an
  /// operator makes by dragging, rather than a side effect of naming.
  ///
  /// Contiguous 0-based, rewritten as a whole list on every reorder — see
  /// products.service.reorder(). Deliberately NO unique constraint: swapping
  /// two rows inside one transaction would violate it midway, and the service
  /// already guarantees the stronger property (a dense 0..n-1 sequence with no
  /// duplicates) by rewriting every row rather than patching two.
  ///
  /// Seeded from the PDP Content Master v5 running order
  /// (scripts/derived-meta.json), the catalogue's own document sequence, so
  /// introducing this field is a deliberate reorder rather than a random one.
  displayOrder Int @default(0)

  /// Max 200 chars (§5.2). Enforced in the DTO too.
  shortDesc    String @db.VarChar(200)
  /// Sanitised Tiptap HTML — sanitised server-side on write, never trusted raw.
  fullDescHtml String @default("")

  proteinPct Int      @default(0)
  /// Up to 8 bullet points, shown as trust badges on the PDP (§5.2).
  benefits   String[]

  /// Species and search tags, e.g. ["betta","halfmoon","plakat"].
  ///
  /// Many-valued on purpose: one feed suits several species, so this is what
  /// powers a "find feed for my fish" filter. Sourced from the PDP master doc's
  /// "Primary Species" / "Also Suitable For" rows.
  tags String[] @default([])

  // Feeding guide (§5.2 tab 5)
  feedFreq      String?
  feedPortion   String?
  feedNotesHtml String?

  /// { fat, fibre, moisture, ash, astaxanthin } — free-form, varies per product.
  nutrition    Json @default("{}")
  /// Storefront-only presentation the CMS does not edit yet: gallery, highlights,
  /// feature grid, FAQ, accent colours. Parked here so schema churn isn't a blocker.
  presentation Json @default("{}")

  seoTitle String?
  seoDesc  String?

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  updatedById String?
  updatedBy   CmsUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  /// The pack whose photography represents this product on listing surfaces.
  ///
  /// IMAGERY ONLY. Price, stock and the Add-to-Cart SKU still follow the first
  /// purchasable pack — those are different questions with deliberately
  /// different answers, and tying them together would either offer a sold-out
  /// SKU or let a stock count change the catalogue's photography.
  ///
  /// The card previously led with "the first pack that is in stock", so a pack
  /// selling out silently changed which photograph a product was shown by. This
  /// makes the choice explicit and stock-independent. NULL falls back to the
  /// first ACTIVE variant by `position`, which is the operator's own ordering
  /// rather than an accident of array order.
  ///
  /// SetNull rather than Cascade: deleting a variant must not delete the
  /// product. A dangling choice falls back to the default, and the presentation
  /// layer re-checks that the pack is still active regardless.
  representativeVariantId String?
  representativeVariant   ProductVariant? @relation("FamilyRepresentative", fields: [representativeVariantId], references: [id], onDelete: SetNull)

  variants      ProductVariant[]
  draft         ProductDraft?
  reviews       Review[]
  spotlights    Spotlight[]
  /// Ordered gallery — photos AND video interleaved. See ProductMedia.
  media         ProductMedia[]
  coupons       CouponProduct[]
  /// Upload signatures minted while editing this product. See UploadTicket.
  uploadTickets UploadTicket[]

  @@index([status, category])
  @@index([deletedAt])
  /// Every storefront listing reads the catalogue in this order.
  @@index([displayOrder])
}

model ProductVariant {
  id       String @id @default(uuid())
  familyId String

  sku  String @unique
  pack String

  /// Money in paise. 249 rupees == 24900.
  mrpPaise   Int
  pricePaise Int
  stock      Int @default(0)

  /// HSN code — required on the invoice (§6.5).
  hsn         String @default("23099090")
  /// Used for shipping weight bands.
  weightGrams Int?

  position Int     @default(0)
  isActive Boolean @default(true)

  /// Which pack this one borrows photography from, when it has none of its own.
  ///
  /// A multipack is physically the same item repeated — "45g x 2" is two of the
  /// 45g bottle — so it legitimately shows the base pack's photos rather than
  /// needing its own shoot.
  ///
  /// This USED to be inferred at render time by stripping an "X2" suffix off the
  /// SKU. That made a merchandising rule depend on a naming convention: renaming
  /// G2-45GX2 silently changed which photographs a customer saw. The relationship
  /// is now data, so a SKU is free to be anything.
  ///
  /// SetNull rather than Cascade: retiring the base pack must not delete the
  /// multipack. It leaves a dangling inheritance the CMS can surface and the
  /// resolver treats as "no source", which is visible rather than silent.
  baseVariantId  String?
  /// How many base units this pack contains. 2 for "45g x 2". Display only —
  /// the resolver keys on baseVariantId, never on this.
  packMultiplier Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family     ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  coupons    CouponVariant[]
  /// Pack-specific photography. Shared assets have variantId = NULL instead.
  media      ProductMedia[]

  /// The asset this pack leads with.
  ///
  /// SetNull so a removed asset leaves "no hero" rather than a dangling id. The
  /// database only guarantees the pointer is valid; that the asset belongs to the
  /// same product and appears in this pack's resolved gallery is enforced in the
  /// service, because neither is expressible as a foreign key.
  heroMediaId String?
  heroMedia   ProductMedia? @relation("VariantHero", fields: [heroMediaId], references: [id], onDelete: SetNull)

  /// Assets explicitly shown for this pack.
  mediaLinks ProductMediaVariant[]

  /// Products this pack is the listing representative for. At most one in
  /// practice — the column lives on ProductFamily and is single-valued.
  representativeFor ProductFamily[] @relation("FamilyRepresentative")

  /// Self-relation for multipack inheritance.
  baseVariant  ProductVariant?  @relation("PackInheritance", fields: [baseVariantId], references: [id], onDelete: SetNull)
  derivedPacks ProductVariant[] @relation("PackInheritance")

  @@index([familyId])
  @@index([stock])
  @@index([baseVariantId])
}

/// What a ProductMedia row holds. Drives which Cloudinary resource type the
/// asset was uploaded as, and which element the storefront renders.
enum MediaType {
  IMAGE
  VIDEO
}

/// Lifecycle of the underlying Cloudinary asset.
///
/// Defaults to READY because every row that existed when this was introduced was
/// already being served — marking them PENDING would have emptied the storefront.
/// PENDING/FAILED become meaningful when two-phase upload lands; ARCHIVED is the
/// soft delete, and is the only state the resolver excludes.
enum MediaStatus {
  PENDING
  READY
  FAILED
  ARCHIVED
}

/// One ordered gallery per product: photos and (at most one) video interleaved.
///
/// Ordering is `position`, NOT the media type — the owner arranges the gallery
/// freely, so "photo, video, photo, photo" is just positions 0..3 with a VIDEO at
/// 1. A product with no video simply has no VIDEO row; nothing special-cases it.
///
/// "At most one VIDEO per family" is enforced TWICE on purpose: the service
/// validates it to return a readable 422, and a partial unique index
/// (`ProductMedia_one_video_per_family`, see the migration) makes it impossible
/// to violate even from raw SQL. The index is not expressible in the Prisma
/// schema, so it lives only in the migration — do not `prisma db push` this
/// schema, as that would silently drop it.
model ProductMedia {
  id       String    @id @default(uuid())
  familyId String
  type     MediaType @default(IMAGE)

  /// Which pack this asset shows, or NULL for a SHARED asset.
  ///
  /// A product sells the same feed in a 45g bottle, a 200g pouch and a 1kg
  /// pouch, and each has its own photography. With everything hanging off the
  /// family alone, a shopper choosing "45g Bottle" was shown 1kg pouch shots.
  ///
  /// NULL means "show for every pack" — fish photos, nutrition panels, feature
  /// graphics. Those are the majority, so nullable is the right default.
  variantId String?

  /// Cloudinary secure_url of the asset itself.
  url      String
  /// Cloudinary public_id, kept so a removed asset can be destroyed rather than
  /// orphaned — an orphan is billed forever.
  publicId String?

  /// Alt text. Required-in-spirit for images (a11y + SEO); videos use it as a
  /// caption/label, so it stays nullable at the DB level.
  alt String?

  /// Position in the gallery. Contiguous from 0, rewritten wholesale on save.
  position Int @default(0)

  /// Poster frame for a VIDEO, derived from Cloudinary rather than uploaded
  /// separately. Null for IMAGE rows. Without one, a <video> paints black until
  /// the first frame decodes.
  posterUrl String?

  /// Intrinsic dimensions, used to reserve layout space and avoid CLS.
  width       Int?
  height      Int?
  /// VIDEO only — surfaced in the CMS so an accidental 10-minute upload is obvious.
  durationSec Float?

  /// Where this asset is in its life. ARCHIVED is a soft delete — the row and its
  /// publicId survive so the Cloudinary asset can be destroyed deliberately later
  /// rather than orphaned and billed forever.
  status     MediaStatus @default(READY)
  archivedAt DateTime?

  family  ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// LEGACY targeting, kept during dual-read. `variantLinks` is the new home for
  /// this relationship; both are read until the join table is fully verified, and
  /// only then is this column retired.
  ///
  /// SetNull stays deliberately: a hard delete of a variant only happens as part
  /// of deleting the whole product family, where this row is cascaded away
  /// anyway. Normal CMS removal deactivates a variant rather than deleting it, so
  /// this column keeps pointing at the inactive pack — which is the correct
  /// outcome, and is what stops pack media silently becoming shared.
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Explicit targeting. One asset, many packs.
  variantLinks    ProductMediaVariant[]
  /// Packs that lead with this asset. SetNull on the other side.
  heroForVariants ProductVariant[]      @relation("VariantHero")

  @@index([familyId, position])
  @@index([variantId])
  @@index([status])
}

/// Which packs an asset is shown for.
///
/// Replaces the single nullable `ProductMedia.variantId`, which could only ever
/// name one pack — so a photo valid for "45g", "45g x 2" and "45g x 3" needed
/// three rows, three Cloudinary uploads, and three things to keep in step.
///
/// The composite primary key is the whole duplicate-prevention story: assigning
/// the same asset to the same pack twice is impossible at the database level, not
/// merely guarded in code. That also makes assignment idempotent — a retried
/// request lands on the same row instead of creating a second one.
model ProductMediaVariant {
  productMediaId String
  variantId      String

  createdAt DateTime @default(now())

  /// Cascade removes the ASSOCIATION only. The ProductMedia row survives with its
  /// publicId intact, so un-assigning an asset never destroys the file.
  media   ProductMedia   @relation(fields: [productMediaId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([productMediaId, variantId])
  @@index([variantId])
}

/// Draft overlay (§5.2). Editing a live product writes here; the live rows are
/// untouched until Publish. Preview renders from this payload.
model ProductDraft {
  id       String @id @default(uuid())
  familyId String @unique

  /// The entire editable family + variants payload, as edited in the CMS.
  payload Json

  updatedById String?
  updatedBy   CmsUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  family ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// ============================================================================
// ORDERS (§6)
// ============================================================================

model Order {
  id      String @id @default(uuid())
  /// ZW-{YYYYMMDD}-{4-digit daily sequence}. Generated in the checkout txn from
  /// OrderCounter — never from COUNT(*).
  orderNo String @unique

  /// Null for guest checkout. Matched to an account by email later if they register.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  email String
  phone String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod

  razorpayOrderId   String?
  razorpayPaymentId String?

  // ---- Money, all paise ----
  subtotalPaise Int
  discountPaise Int @default(0)
  shippingPaise Int @default(0)
  taxPaise      Int @default(0)
  totalPaise    Int

  /// The primary code — first in the applied stack. Kept as a scalar because
  /// invoices, emails and the order list all read a single code, and every
  /// order placed before stacking existed has exactly one.
  couponCode  String?
  /// Every code applied to this order, in the order the engine accepted them.
  couponCodes String[] @default([])

  /// Snapshot at purchase time: { name, line1, line2, city, state, pincode, phone }.
  shippingAddress Json

  /// Entered manually, must match the Tally sequence. No auto-generation (§6.5).
  /// Required before the order can move past PROCESSING.
  invoiceNumber String?

  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  /// What the CUSTOMER typed at checkout ("leave at the gate"). Read-only for
  /// staff — it is the shopper's own words and must not be edited or overwritten.
  ///
  /// Previously the checkout wrote this into `internalNote`, so a customer's
  /// delivery instruction landed in the staff-only field and the first staff note
  /// silently destroyed it.
  customerNote String?

  /// Staff-only. Never sent to the customer (§6.3).
  internalNote String?
  cancelReason String?

  /// Guards against double-submits on checkout.
  idempotencyKey String? @unique

  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  items       OrderItem[]
  emails      OrderEmail[]
  refunds     Refund[]
  redemptions CouponRedemption[]

  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([email])
  @@index([customerId])
  // Supports the stock-release sweep for abandoned Razorpay orders.
  @@index([status, paymentStatus, placedAt])
  /// Order-history eligibility: "how many qualifying orders has this email
  /// placed?" runs on every coupon evaluation, so it gets its own index.
  @@index([email, status, paymentStatus])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  /// Nullable: the SKU may be deleted later. The snapshot below is authoritative.
  variantId String?

  // ---- Snapshots. The invoice reads these, not the live catalogue. ----
  productName    String
  sku            String
  pack           String
  unitPricePaise Int
  qty            Int
  hsn            String
  taxRatePct     Decimal @db.Decimal(5, 2)
  lineTotalPaise Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// What the customer was actually sent, and when (§6.3 + §15).
model OrderEmail {
  id      String @id @default(uuid())
  orderId String

  subject           String
  toEmail           String
  status            EmailStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Refund {
  id      String @id @default(uuid())
  orderId String

  amountPaise      Int
  reason           String
  razorpayRefundId String?
  processedById    String?

  createdAt DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy CmsUser? @relation(fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Monotonic sequence per document series.
///
/// The id is the series key, not a date: numbering is now
/// `27ZFO###` / `27ZFI###` — a financial-year prefix plus a running number that
/// does NOT reset daily. Keys look like "27ZFO" and "27ZFI".
///
/// Legacy per-day rows (id "20260728") are harmless; nothing reads them.
model OrderCounter {
  /// Series key, e.g. "27ZFO" (orders) or "27ZFI" (invoices).
  dateKey String @id
  seq     Int    @default(0)
}

// ============================================================================
// CUSTOMERS (§7)
// ============================================================================

model Customer {
  id    String  @id @default(uuid())
  email String  @unique
  phone String?

  firstName String
  lastName  String

  /// Null for guest-only records (order placed, never registered).
  passwordHash String?

  /// BANNED prevents login and shows "Your account has been suspended" (§7.2).
  status CustomerStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  registeredAt    DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  passwordResets     CustomerPasswordReset[]
  emailVerifications CustomerEmailVerification[]

  @@index([status])
}

/// Email verification tokens for storefront customer signup.
///
/// Plaintext token is emailed; only the sha256 hash is stored in the database.
/// Tokens are single-use (`usedAt`), short-lived (`expiresAt`), and cascade-deleted
/// if the customer is deleted.
model CustomerEmailVerification {
  id         String    @id @default(uuid())
  customerId String
  /// sha256 of the emailed token. Unique so a lookup is a single indexed hit.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment the token is spent, which is what makes it single-use.
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// Password reset tokens for storefront customers.
///
/// The token is emailed in plaintext and stored only as a sha256 hash, so a
/// leaked database dump cannot be used to reset anyone's password. Rows are
/// single-use (`usedAt`) and short-lived (`expiresAt`).
///
/// Separate from the staff flow deliberately: staff have 2FA and a different
/// threat model, and reusing one table would blur which surface a token grants.
model CustomerPasswordReset {
  id         String    @id @default(uuid())
  customerId String
  /// sha256 of the emailed token. Unique so a lookup is a single indexed hit.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment the token is spent, which is what makes it single-use.
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id         String @id @default(uuid())
  customerId String

  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ============================================================================
// CMS USERS (§11, §14)
//
// Deliberately a separate table from Customer: different auth, different
// lifecycle, different threat model. Staff get mandatory 2FA; customers do not.
// ============================================================================

model CmsUser {
  id    String @id @default(uuid())
  email String @unique
  name  String

  /// bcrypt, cost 12 (§14.1).
  passwordHash String

  role   Role
  status CmsUserStatus @default(ACTIVE)

  phone       String?
  activatedAt DateTime?

  // ---- 2FA — mandatory for every role (§14.3) ----
  twofaMethod     TwofaMethod?
  /// AES-256-GCM encrypted at rest.
  twofaSecret     String?
  twofaEnrolledAt DateTime?

  /// Last 5 bcrypt hashes — blocks reuse (§14.2).
  passwordHistory Json @default("[]")

  /// Bumped on deactivate / password change / "terminate all sessions".
  /// Access tokens carry this; a mismatch invalidates the token without a DB
  /// lookup on every request. This is how §11.3 works.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invitation      CmsInvitation?
  invitationsSent CmsInvitation[] @relation("InvitedBy")

  sessions         CmsSession[]
  backupCodes      BackupCode[]
  emailOtps        CmsEmailOtp[]
  auditLogs        AuditLog[]
  refundsHandled   Refund[]
  productsUpdated  ProductFamily[]
  productDrafts    ProductDraft[]
  articles         Article[]
  reviewsModerated Review[]

  /// Upload signatures this operator requested. See UploadTicket.
  uploadTickets UploadTicket[]

  @@index([status])
  @@index([deletedAt])
}

model CmsInvitation {
  id     String  @id @default(uuid())
  userId String  @unique
  user   CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  invitedById String?
  invitedBy   CmsUser? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tokenHash])
  @@index([userId])
}

model CmsSession {
  id     String @id @default(uuid())
  userId String

  refreshTokenHash String  @unique
  ip               String
  userAgent        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// 8 single-use codes, generated at 2FA setup (§14.3). Stored hashed.
model BackupCode {
  id     String @id @default(uuid())
  userId String

  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email OTP verification codes for CMS users (§14).
///
/// Plaintext 6-digit code is emailed; only the sha256 hash is stored in the database.
/// Rows are single-use (`usedAt`), short-lived (`expiresAt`), limited by attempts (`maxAttempts`),
/// and cascade-deleted if the user is deleted.
model CmsEmailOtp {
  id          String    @id @default(uuid())
  userId      String
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// REVIEWS (§9)
// ============================================================================

model Review {
  id       String @id @default(uuid())
  familyId String

  /// Null for guest reviews.
  customerId String?
  guestName  String?
  email      String

  rating Int
  body   String

  isVerifiedPurchase Boolean     @default(false)
  state              ReviewState @default(PENDING)

  moderatedById String?
  moderatedAt   DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family      ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  moderatedBy CmsUser?      @relation(fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([state, submittedAt])
  @@index([familyId, state])
}

// ============================================================================
// COUPONS (§10)
// ============================================================================

model Coupon {
  id   String @id @default(uuid())
  /// Uppercase alphanumeric + hyphens only (§10.2).
  code String @unique

  discountType  DiscountType
  /// Paise when FLAT, whole percent when PERCENTAGE.
  discountValue Int

  minOrderPaise Int @default(0)

  startsAt DateTime
  endsAt   DateTime

  /// Null means unlimited (§10.2).
  totalUsageLimit  Int?
  perCustomerLimit Int  @default(1)
  usedCount        Int  @default(0)

  isActive Boolean @default(true)

  /// ALL_PRODUCTS applies the discount to the whole cart; SPECIFIC_PRODUCTS
  /// restricts it to the families in `products`, and the discount is then
  /// computed on the ELIGIBLE portion of the cart only.
  scope CouponScope @default(ALL_PRODUCTS)

  // ---- Presentation (CMS only; never shown to a customer) ------------------
  /// Internal name, e.g. "Monsoon 2026 winback". Falls back to the code.
  name        String?
  /// What this promotion is for, for whoever inherits it.
  description String?

  // ---- Discount shaping ----------------------------------------------------
  /// Ceiling on a percentage discount, in paise. Null means uncapped.
  /// Ignored for FLAT, which is already an absolute amount.
  maxDiscountPaise Int?

  // ---- Combination ---------------------------------------------------------
  /// Enforced server-side in modules/promotions/stacking.ts. The storefront
  /// never decides this.
  stackingMode          CouponStacking @default(NON_STACKABLE)
  /// Tie-break when several promotions are eligible and the customer expressed
  /// no order. Lower wins; ties fall back to code A→Z so the result is always
  /// deterministic.
  priority              Int            @default(0)
  /// Whether a code the customer typed may sit alongside automatic promotions.
  combinesWithAutomatic Boolean        @default(true)

  /// CODE means the customer must enter it; AUTOMATIC applies on eligibility.
  trigger CouponTrigger @default(CODE)

  // ---- Eligibility ---------------------------------------------------------
  customerEligibility  CustomerEligibility @default(ALL_CUSTOMERS)
  /// N for FIRST_N_ORDERS. Ignored otherwise.
  firstNOrders         Int?
  /// Minimum total units in the cart (or in the qualifying set, when one exists).
  minQty               Int?
  /// Upper bound on units, for a promotion meant to stay small.
  maxQty               Int?
  /// Delivery states this promotion is offered in. Empty means everywhere.
  allowedStates        String[]            @default([])
  /// When qualifying products are listed: must the cart contain ALL of them
  /// (A + B), or is ANY one enough?
  requireAllQualifiers Boolean             @default(false)

  // ---- Revenue attribution -------------------------------------------------
  // Denormalised running totals, incremented when an order is CONFIRMED (paid,
  // or accepted for COD) — not at checkout. A coupon on an abandoned or
  // cancelled order must not inflate reported revenue.
  //
  // Kept as columns rather than computed on read because the coupon list shows
  // them for every row; a per-row aggregate would be N queries.
  /// Cart value of confirmed orders that used this coupon, in paise.
  revenuePaise    Int @default(0)
  /// Discount actually given away on those orders, in paise.
  discountedPaise Int @default(0)
  /// Confirmed orders that used it. May trail `usedCount`, which counts attempts.
  confirmedOrders Int @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  redemptions CouponRedemption[]
  products    CouponProduct[]
  variants    CouponVariant[]
  categories  CouponCategory[]
  customers   CouponCustomer[]
  bxgy        CouponBxgy?

  @@index([isActive, startsAt, endsAt])
  /// The automatic-promotion sweep: every live AUTOMATIC promotion, in the
  /// order the engine will consider them.
  @@index([trigger, isActive, priority])
}

/// Join table for SPECIFIC_PRODUCTS scope. A row means "this coupon applies to
/// this product family".
model CouponProduct {
  couponId String
  familyId String
  /// DISCOUNT is the default because it is what every pre-existing row meant:
  /// SPECIFIC_PRODUCTS restricted where the discount landed.
  role     CouponTargetRole @default(DISCOUNT)

  coupon Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  family ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  /// Includes `role`, so one family can both qualify a promotion and receive it.
  @@id([couponId, familyId, role])
  @@index([familyId])
}

/// Pack-level targeting — "45g only", not the whole product.
model CouponVariant {
  couponId  String
  variantId String
  role      CouponTargetRole @default(DISCOUNT)

  coupon  Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([couponId, variantId, role])
  @@index([variantId])
}

/// Category targeting. Category is an enum on ProductFamily, so this stores the
/// value rather than joining a table.
model CouponCategory {
  couponId String
  category Category
  role     CouponTargetRole @default(DISCOUNT)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@id([couponId, category, role])
}

/// Named customers, for SPECIFIC_CUSTOMERS eligibility.
///
/// Keyed on lowercased EMAIL rather than customerId, because that is the
/// identity checkout actually resolves — a guest has an email before they have
/// an account, and registration later claims the same row.
model CouponCustomer {
  couponId String
  email    String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@id([couponId, email])
  @@index([email])
}

/// Buy X Get Y configuration. One row per BUY_X_GET_Y coupon.
///
/// The X side is the coupon's QUALIFY targeting rows; this describes the Y side:
/// how many qualifying units are needed, how many reward units that earns, and
/// how deeply those reward units are discounted.
model CouponBxgy {
  couponId String @id

  /// Units of the qualifying set needed to earn one reward batch.
  buyQty           Int
  /// Reward units granted per batch.
  getQty           Int
  /// 100 means the reward units are free; 50 means half price.
  rewardPercentOff Int  @default(100)
  /// How many times the offer may repeat in one cart. Null means unlimited.
  maxRepeats       Int?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model CouponRedemption {
  id       String @id @default(uuid())
  couponId String
  orderId  String

  customerId String?
  email      String

  /// Snapshot of what this redemption was worth, so the per-coupon report does
  /// not depend on the order still existing in its original state.
  cartValuePaise Int @default(0)
  discountPaise  Int @default(0)

  /// Set when the order is confirmed (paid, or COD accepted). Null while the
  /// order is still pending — only confirmed rows count toward revenue.
  confirmedAt DateTime?

  /// Set when the order was cancelled or fully refunded and the coupon use was
  /// handed back. A released row keeps its history but stops counting against
  /// the customer's per-customer allowance.
  releasedAt DateTime?

  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, email])
}

// ============================================================================
// CONTENT (§8)
// ============================================================================

model Article {
  id    String @id @default(uuid())
  slug  String @unique
  title String

  tag         String
  readMinutes Int    @default(5)

  excerpt       String
  /// Sanitised Tiptap HTML.
  bodyHtml      String @default("")
  /// The storefront's structured block array (lead / h2 / p / stat-block /
  /// pullquote). Kept so the existing renderer in Frontend/lib/articles.js works.
  contentBlocks Json?

  coverImageUrl String?
  coverImageId  String?

  status   ContentStatus @default(DRAFT)
  seoTitle String?
  seoDesc  String?

  authorName String

  /// Draft overlay, same pattern as products (§8.1).
  draftPayload Json?

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  updatedById String?
  updatedBy   CmsUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([tag])
}

/// Rotating spotlight on the products listing page — up to 3 active (§8.2).
model Spotlight {
  id       String @id @default(uuid())
  familyId String

  tagline  String
  subText  String
  badge    String?
  imageUrl String?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([isActive, position])
}

/// Exactly two rows: LIVE and DRAFT. Publish copies DRAFT.sections onto LIVE so
/// all pending homepage edits go live at once (§8.3).
model HomepageContent {
  id      String         @id @default(uuid())
  version ContentVersion @unique

  /// { hero, science, why, knowledge, announcement }
  sections Json

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  updatedById String?
}

// ============================================================================
// SETTINGS (§13)
// ============================================================================

/// Key/value so a new settings group is a data change, not a migration.
/// Keys: "shipping" | "tax" | "announcement" | "maintenance"
model Setting {
  key   String @id
  value Json

  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// AUDIT LOG (§12)
//
// Append-only. The migration that creates this table also REVOKEs UPDATE and
// DELETE from the application role — §12 says no one can edit entries, including
// Admins, so that is enforced in the database rather than only in app code.
// ============================================================================

model AuditLog {
  id BigInt @id @default(autoincrement())

  actorId   String?
  /// Denormalised so entries survive a user delete (§11.3: the name stays
  /// visible in the log against past actions).
  actorName String
  actorRole String

  module AuditModule
  /// Human-readable, e.g. "Updated stock for F3-45G from 120 to 96" (§12.1).
  action String

  recordId String?
  /// Before/after, when a diff is meaningful.
  diff     Json?

  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  actor CmsUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([recordId])
}

/// A signature that was minted, and what became of it.
///
/// The gap this closes: the browser uploads straight to Cloudinary, so between
/// minting a signature and the CMS saving the product, an asset can exist in the
/// account that no database row references — the tab was closed, the network
/// dropped, the save failed. Nothing knew those assets existed, so nothing could
/// ever clean them up and they billed forever.
///
/// A ticket is written BEFORE the browser is told where to upload, and the
/// public_id is generated here rather than accepted from the client, so the row
/// always knows exactly what may appear in Cloudinary.
model UploadTicket {
  id String @id @default(uuid())

  /// The public_id this signature authorises. Server-generated and unique, so a
  /// client cannot aim an upload at somebody else's asset.
  publicId String @unique

  /// image | video — selects the Cloudinary endpoint and the delete endpoint.
  resourceType String
  folder       String

  /// Which product the operator was editing. Null for article and spotlight
  /// uploads, which are not part of a product gallery.
  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  status UploadTicketStatus @default(SIGNED)

  /// Set when Cloudinary confirms the bytes landed — either the webhook or the
  /// reconciliation sweep. Until then we do not know the asset exists.
  uploadedAt    DateTime?
  /// Set when a ProductMedia row starts referencing this publicId.
  attachedAt    DateTime?
  /// Cloudinary's own message when it rejected the upload.
  failureReason String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requestedById String?
  requestedBy   CmsUser? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([familyId])
}

/// Where a minted signature got to.
enum UploadTicketStatus {
  /// Signature issued; the browser may or may not have uploaded anything yet.
  SIGNED
  /// Cloudinary confirmed the asset exists, but no ProductMedia references it.
  /// This is the orphan state the reconciliation sweep acts on.
  UPLOADED
  /// A ProductMedia row references the publicId. Nothing to clean up.
  ATTACHED
  /// Cloudinary rejected the upload, or processing failed.
  FAILED
  /// The asset was destroyed in Cloudinary and the ticket closed.
  DISCARDED
}
