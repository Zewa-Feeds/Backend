{
  // Typechecks files outside src/ (the Prisma seed, prisma.config.ts, one-off
  // scripts). They run through tsx and are never compiled to dist/, so they need
  // their own scope — but they should still be typechecked in CI.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  // src/types carries the Express `req.user` augmentation, which scripts that
  // import route-adjacent services (e.g. the audit writer) need too.
  "include": ["prisma/**/*.ts", "scripts/**/*.ts", "prisma.config.ts", "src/types/**/*.d.ts"]
}
