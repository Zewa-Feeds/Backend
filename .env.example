# ============================================================================
# Zewa Feeds Backend — environment template
#
# Copy to .env and fill in. The app validates all of this at boot (src/config/env.ts)
# and refuses to start if anything required is missing or malformed.
#
# Generate secrets with:  openssl rand -base64 48
# Generate the 2FA key with:  openssl rand -hex 32
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Data ------------------------------------------------------------------
# Local dev via docker compose (see docker/docker-compose.yml).
DATABASE_URL=postgresql://zewa:zewa_local_dev@localhost:5433/zewa_feeds?schema=public
REDIS_URL=redis://localhost:6380

# ---- Auth (§14) ------------------------------------------------------------
# Each must be >= 32 chars. Use DIFFERENT values for each — never reuse one secret.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PREVIEW_SECRET=
# Exactly 64 hex chars (32 bytes) — AES-256-GCM key for CmsUser.twofaSecret at rest.
TWOFA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=8h
REFRESH_TOKEN_TTL_REMEMBER=7d
PREVIEW_TOKEN_TTL=15m
BCRYPT_COST=12

# ---- CORS ------------------------------------------------------------------
STOREFRONT_ORIGIN=http://localhost:3000
CMS_ORIGIN=http://localhost:3001
EXTRA_CORS_ORIGINS=

# ---- Razorpay (§6.4) -------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Payment mode ----------------------------------------------------------
# TEMPORARY — development only.
# TODO: Replace with production Razorpay verification.
# true  => payments auto-confirm 30s after creation, no real money, no credentials
# false => the real RazorpayProvider runs (requires the keys above)
# Refused outright when NODE_ENV=production.
RAZORPAY_AUTO_CONFIRM=true

# Either method can be switched off per deployment without code changes.
PAYMENT_RAZORPAY_ENABLED=true
PAYMENT_COD_ENABLED=false

# Minutes an unpaid online order holds its stock before it is cancelled.
UNPAID_ORDER_TTL_MINUTES=30

# ---- Cloudinary (§16.1) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- ZeptoMail (§15) -------------------------------------------------------
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=orders@zewafeeds.com
ZEPTOMAIL_FROM_NAME=Zewa Feeds

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=

# ---- Company details — printed on invoices (§6.5) --------------------------
COMPANY_NAME=Zewa Ecosystems Pvt Ltd
COMPANY_GSTIN=27AABCZ1234E1Z5
# Place of supply: decides CGST+SGST (intra-state) vs IGST (inter-state).
COMPANY_STATE=Maharashtra
COMPANY_ADDRESS=Zewa Ecosystems Pvt Ltd, Thrissur, Kerala, India
COMPANY_EMAIL=orders@zewafeeds.com
COMPANY_PHONE=+91 00000 00000
